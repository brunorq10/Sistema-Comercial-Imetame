generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Perfil {
  ADM_COMERCIAL
  GESTAO_COMERCIAL
  ORCAMENTISTA
  GESTAO_ACORDOS
  ACORDOS
  ADM_GERAL
}

enum StatusAnalise {
  AGUARDANDO
  APROVADA
  REPROVADA
}

enum StatusSolicitacao {
  AGUARDANDO_ANALISE
  EM_ELABORACAO
  PROPOSTA_ENVIADA
  CONTRATO_GANHO
  RECUSADA
  CANCELADA
  SUSPENSA
}

enum Classificacao {
  OBRAS
  PARADAS
  OLEO_GAS
  FABRICACOES
}

enum Interesse {
  ALTO
  MEDIO
  BAIXO
}

enum Origem {
  EMAIL
  TELEFONE
  VISITA
  INDICACAO
  OUTRO
}

enum Segmento {
  PAPEL_CELULOSE
  SIDERURGIA
  OLEO_GAS
  OUTROS
}

enum MotivoReprovacao {
  VOLUME_ADJUDICADO
  FORA_LINHA_FORNECIMENTO
  INDISPONIBILIDADE_MO
  SEM_SERVICO_LOCAL
  LIMITACAO_EQUIPAMENTOS
  DIFICULDADE_PARCERIA
  OUTROS
}

enum MotivoPerda {
  PRECO
  PRAZO
  ESCOPO
  CONCORRENCIA
  CLIENTE_DESISTIU
  OUTRO
}

enum StatusAcordo {
  ATIVO
  ENCERRADO
  CANCELADO
}

enum StatusFaturamento {
  A_FATURAR
  FATURADO
  PARCIAL
  CANCELADO
}

enum RamoAtuacao {
  PAPEL_CELULOSE_OBRAS
  PAPEL_CELULOSE_PARADAS
  SIDERURGIA
  OLEO_GAS
  OLEO_GAS_PETRO
  OUTROS
}

// ─── Modelos ─────────────────────────────────────────────────────────────────

model User {
  id                  Int       @id @default(autoincrement())
  nome                String
  email               String    @unique
  password_hash       String
  perfil              Perfil
  funcao              String?
  ativo               Boolean   @default(true)
  is_analista_critico Boolean   @default(false)
  deactivated_at      DateTime?
  deactivated_by      Int?
  updated_by          Int?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  // Auto-relação: quem desativou / quem foi a última pessoa a editar este usuário
  desativado_por         User?              @relation("UserDeactivatedBy", fields: [deactivated_by], references: [id])
  atualizado_por         User?              @relation("UserUpdatedBy", fields: [updated_by], references: [id])
  usuarios_desativados   User[]             @relation("UserDeactivatedBy")
  usuarios_atualizados   User[]             @relation("UserUpdatedBy")
  historico              UsuarioHistorico[] @relation("UsuarioHistUsuario")
  historico_alterado_por UsuarioHistorico[] @relation("UsuarioHistCriador")
  login_historico        LoginHistorico[]

  solicitacoes_criadas             Solicitacao[]                   @relation("SolicitacaoCriador")
  solicitacoes_atribuidas          Solicitacao[]                   @relation("SolicitacaoOrcamentista")
  propostas_tecnicas               PropostaTecnica[]
  propostas_comerciais             PropostaComercial[]
  propostas_fabricacao             PropostaFabricacao[]
  solicitacoes_info                SolicitacaoInfo[]
  acordos                          Acordo[]
  notas_fiscais                    NotaFiscal[]
  notificacoes                     Notificacao[]
  contratos_responsavel            Contrato[]                      @relation("ContratoResponsavel")
  contratos_criados                Contrato[]                      @relation("ContratoCriador")
  hh_lancamentos                   HhLancamento[]                  @relation("HhLancamentoCriador")
  hh_realizados                    HhRealizado[]                   @relation("HhRealizadoCriador")
  hh_realizados_dia_criados        HhRealizadoDia[]                @relation("HhRealizadoDiaCriador")
  fabricacao_itens_criados         FabricacaoItem[]                @relation("FabricacaoItemCriador")
  fabricacao_realizados            FabricacaoRealizado[]           @relation("FabricacaoRealizadoCriador")
  fabricacao_item_historico        FabricacaoItemHistorico[]       @relation("FabItemHistCriador")
  hh_acomp_historico               HhAcompanhamentoHistorico[]     @relation("HhAcompHistCriador")
  ucr_faixas_criadas               UcrFaixaVigencia[]              @relation("UcrFaixaVigenciaCriador")
  ucr_faixas_atualizadas           UcrFaixaVigencia[]              @relation("UcrFaixaVigenciaAtualizador")
  ucr_faixas_historico             UcrFaixaHistorico[]             @relation("UcrFaixaHistCriador")
  parada_fechada_por               ParadaHhConfig[]                @relation("ParadaFechadaPor")
  parada_fechamento_historico      ParadaFechamentoHistorico[]     @relation("ParadaFechHistCriador")
  parada_config_historico          ParadaHhConfigHistorico[]       @relation("ParadaHhConfigHistCriador")
  parada_folga_linhas              ParadaFolgaLinha[]              @relation("ParadaFolgaLinhaCriador")
  contratos_hh_fechados_por        Contrato[]                      @relation("ContratoHhFechadaPor")
  contrato_hh_fechamento_historico ContratoHhFechamentoHistorico[] @relation("ContratoHhFechHistCriador")
  subindices_criados               SubIndiceFaturamento[]          @relation("SubIndiceCriador")
  nfs_contratos_criadas            NotaFiscalContrato[]            @relation("NFContratoCriador")
  consolidados_criados             ConsolidadoMes[]                @relation("ConsolidadoCriador")
  historico_subindices             HistoricoSubIndice[]            @relation("HistSubIndiceCriador")
  historico_contratos              HistoricoContrato[]             @relation("HistContratoCriador")
  ocorrencias_criadas              OcorrenciaContratual[]          @relation("OcorrenciaCriador")
  multas_criadas                   MultaPenalidade[]               @relation("MultaCriador")
  historico_solicitacoes           HistoricoSolicitacao[]          @relation("HistSolicitacaoCriador")
  subindices_comentario            SubIndiceFaturamento[]          @relation("SubIndiceComentarioAutor")
  alteracoes_responsavel           PrevisaoAlteracao[]             @relation("AlteracaoResponsavel")
  alteracoes_revisor               PrevisaoAlteracao[]             @relation("AlteracaoRevisor")
  alteracoes_criadas               PrevisaoAlteracao[]             @relation("AlteracaoCriador")
  analista_critico_historicos      AnalistaCriticoHistorico[]      @relation("AnalistaCriticoUser")
  analista_critico_execucoes       AnalistaCriticoHistorico[]      @relation("AnalistaCriticoExecutor")
  relatorios_criados               RelatorioSalvo[]                @relation("RelatorioCriador")
  relatorios_versoes               RelatorioVersao[]               @relation("RelatorioVersaoAutor")
  revisoes_criadas                 RevisaoPendente[]               @relation("RevisaoPendenteCriador")
  relatorios_os_criados            RelatorioOS[]                   @relation("RelatorioOSCriador")
  revisoes_avaliadas               RevisaoPendente[]               @relation("RevisaoPendenteAvaliador")
  cenario_config_atualizacoes      CenarioConfig[]                 @relation("CenarioConfigAtualizador")
  cenario_lancamentos_criados      CenarioLancamento[]             @relation("CenarioLancCriador")
  cenario_lancamentos_atualizados  CenarioLancamento[]             @relation("CenarioLancAtualizador")
  cenario_lancamentos_historico    CenarioLancamentoHistorico[]    @relation("CenarioLancHistCriador")
  cenario_retratos_criados         CenarioRetrato[]                @relation("CenarioRetratoCriador")

  // Substituições e transferências de responsabilidade
  substituicoes_como_titular         SubstituicaoTemporaria[]        @relation("SubstTitular")
  substituicoes_como_substituto      SubstituicaoTemporaria[]        @relation("SubstSubstituto")
  substituicoes_criadas              SubstituicaoTemporaria[]        @relation("SubstCriador")
  substituicoes_prorrogacoes_criadas SubstituicaoProrrogacao[]       @relation("SubstProrrogacaoCriador")
  transferencias_origem              TransferenciaResponsabilidade[] @relation("TransfOrigem")
  transferencias_destino             TransferenciaResponsabilidade[] @relation("TransfDestino")
  transferencias_criadas             TransferenciaResponsabilidade[] @relation("TransfCriador")

  // Rastreabilidade — auditoria (quem cancelou / quem excluiu / quem solicitou / quem revisou)
  solicitacoes_canceladas        Solicitacao[]              @relation("SolicitacaoCanceladaPor")
  contratos_cancelados           Contrato[]                 @relation("ContratoCanceladoPor")
  contratos_deletados            Contrato[]                 @relation("ContratoDeletadoPor")
  contratos_hh_cancelados        Contrato[]                 @relation("ContratoHhCanceladoPor")
  cenario_lancamentos_cancelados CenarioLancamento[]        @relation("CenarioLancCanceladoPor")
  relatorios_deletados           RelatorioSalvo[]           @relation("RelatorioDeletadoPor")
  solicitacoes_info_deletadas    SolicitacaoInfo[]          @relation("SolicitacaoInfoDeletadoPor")
  fabricacao_itens_deletados     FabricacaoItem[]           @relation("FabricacaoItemDeletadoPor")
  ocorrencias_deletadas          OcorrenciaContratual[]     @relation("OcorrenciaDeletadoPor")
  multas_deletadas               MultaPenalidade[]          @relation("MultaDeletadoPor")
  multas_historico               MultaPenalidadeHistorico[] @relation("MultaHistCriador")
  subindices_deletados           SubIndiceFaturamento[]     @relation("SubIndiceDeletadoPor")
  nfs_deletadas                  NotaFiscalContrato[]       @relation("NFContratoDeletadoPor")
  nfs_solicitadas                NotaFiscalContrato[]       @relation("NFContratoSolicitadoPor")
  nfs_revisadas                  NotaFiscalContrato[]       @relation("NFContratoRevisadoPor")
  clientes_criados               Cliente[]                  @relation("ClienteCriador")
  clientes_desativados           Cliente[]                  @relation("ClienteDeactivatedBy")
  clientes_atualizados           Cliente[]                  @relation("ClienteUpdatedBy")
  clientes_historico             ClienteHistorico[]         @relation("ClienteHistCriador")
  hh_realizado_dia_historico     HhRealizadoDiaHistorico[]  @relation("HhRealizadoDiaHistCriador")
  parada_hh_dia_historico        ParadaHhDiaHistorico[]     @relation("ParadaHhDiaHistCriador")

  @@map("users")
}

model Cliente {
  id               Int          @id @default(autoincrement())
  codigo           String?      @unique
  nome             String
  cnpj             String?
  contato_nome     String?
  contato_email    String?
  contato_telefone String?
  cidade           String?
  estado           String?      @db.VarChar(2)
  ramo_atuacao     RamoAtuacao?
  segmento         Segmento?
  ativo            Boolean      @default(true)
  deactivated_at   DateTime?
  deactivated_by   Int?
  updated_by       Int?
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  created_by       Int

  solicitacoes              Solicitacao[]      @relation("SolicitacaoCliente")
  solicitacoes_como_final   Solicitacao[]      @relation("SolicitacaoClienteFinal")
  acordos                   Acordo[]
  contratos                 Contrato[]         @relation("ContratoCliente")
  contratos_como_final      Contrato[]         @relation("ContratoClienteFinal")
  filiais                   Filial[]
  relatorios_os_faturamento RelatorioOS[]      @relation("RelatorioOSClienteFat")
  criador                   User               @relation("ClienteCriador", fields: [created_by], references: [id])
  desativado_por            User?              @relation("ClienteDeactivatedBy", fields: [deactivated_by], references: [id])
  atualizado_por            User?              @relation("ClienteUpdatedBy", fields: [updated_by], references: [id])
  historico                 ClienteHistorico[]

  @@map("clientes")
}

// Auditoria de alterações cadastrais do Cliente — mesmo formato de FabricacaoItemHistorico.
model ClienteHistorico {
  id         Int      @id @default(autoincrement())
  cliente_id Int
  campo      String
  valor_de   String?
  valor_para String?
  created_at DateTime @default(now())
  created_by Int

  cliente Cliente @relation(fields: [cliente_id], references: [id], onDelete: Cascade)
  usuario User    @relation("ClienteHistCriador", fields: [created_by], references: [id])

  @@index([cliente_id])
  @@map("clientes_historico")
}

model Filial {
  id         Int      @id @default(autoincrement())
  cliente_id Int
  nome       String?
  cidade     String
  estado     String   @db.VarChar(2)
  ativo      Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by Int

  cliente Cliente @relation(fields: [cliente_id], references: [id])

  @@index([cliente_id])
  @@map("filiais")
}

model Solicitacao {
  id                            Int               @id @default(autoincrement())
  numero                        String            @unique
  cliente_id                    Int
  cliente_final_id              Int?
  data_recebimento              DateTime?
  segmento                      Segmento?
  contato                       String?
  referencia_cliente            String?
  comprador                     String?
  telefone_comprador            String?
  email_comprador               String?
  cidade                        String?
  estado                        String?           @db.VarChar(2)
  origem                        Origem?
  escopo                        String?
  classificacao                 Classificacao?
  interesse                     Interesse?
  status                        StatusSolicitacao @default(AGUARDANDO_ANALISE)
  status_analise                StatusAnalise     @default(AGUARDANDO)
  prazo_tecnica                 DateTime?
  prazo_tecnica_indeterminado   Boolean           @default(false)
  prazo_comercial               DateTime?
  prazo_comercial_indeterminado Boolean           @default(false)
  orcamentista_id               Int?
  visita_tecnica                Boolean           @default(false)
  data_visita                   DateTime?
  // Portal: solicitação vinda de portal do cliente, com data+hora de fechamento
  is_portal                     Boolean           @default(false)
  portal_hora                   String?           @db.VarChar(5) // legado (só hora) — usar portal_fechamento
  portal_fechamento             DateTime?
  motivo_recusa                 String?
  motivo_reprovacao             MotivoReprovacao?
  obs_reprovacao                String?
  revisao_esperada              Int               @default(1)
  as_sold                       Boolean           @default(false)
  created_at                    DateTime          @default(now())
  updated_at                    DateTime          @updatedAt
  created_by                    Int
  cancelled_at                  DateTime?
  cancel_reason                 String?
  cancelled_by                  Int?
  suspended_at                  DateTime?
  suspend_reason                String?
  // Cancelamento da PROPOSTA (aba Propostas) — reversível, não afeta a solicitação
  proposta_cancelada_at         DateTime?
  proposta_cancel_reason        String?
  data_atribuicao               DateTime?

  cliente       Cliente  @relation("SolicitacaoCliente", fields: [cliente_id], references: [id])
  cliente_final Cliente? @relation("SolicitacaoClienteFinal", fields: [cliente_final_id], references: [id])
  orcamentista  User?    @relation("SolicitacaoOrcamentista", fields: [orcamentista_id], references: [id])
  criador       User     @relation("SolicitacaoCriador", fields: [created_by], references: [id])
  cancelador    User?    @relation("SolicitacaoCanceladaPor", fields: [cancelled_by], references: [id])

  propostas_tecnicas   PropostaTecnica[]
  propostas_comerciais PropostaComercial[]
  propostas_fabricacao PropostaFabricacao[]
  contratos            Contrato[]
  solicitacoes_info    SolicitacaoInfo[]
  historico            HistoricoSolicitacao[]
  revisoes_pendentes   RevisaoPendente[]
  relatorio_os         RelatorioOS?

  @@index([cliente_id])
  @@index([cliente_final_id])
  @@index([orcamentista_id])
  @@index([status])
  @@index([created_at])
  @@index([cancelled_at])
  @@index([status_analise])
  @@map("solicitacoes")
}

model HistoricoSolicitacao {
  id               Int      @id @default(autoincrement())
  solicitacao_id   Int
  campo            String
  valor_de         String?
  valor_para       String?
  created_at       DateTime @default(now())
  created_by       Int
  // Preenchido quando a ação foi feita por um substituto temporário (Cadastros
  // > Substituições) atuando no lugar do titular — auditoria, sem relação FK
  // (mesmo padrão de solicitado_por/revisado_por em NotaFiscalContrato).
  substituto_de_id Int?

  solicitacao Solicitacao @relation(fields: [solicitacao_id], references: [id], onDelete: Cascade)
  usuario     User        @relation("HistSolicitacaoCriador", fields: [created_by], references: [id])

  @@index([solicitacao_id])
  @@map("historico_solicitacoes")
}

// Contador do sequencial anual usado no número da solicitação (padrão da
// empresa: IME-O-0001.26). Uma linha por ano; o sequencial é incrementado
// atomicamente via upsert (INSERT ... ON CONFLICT DO UPDATE, uma única
// instrução no Postgres) — garante que duas solicitações criadas ao mesmo
// tempo nunca recebam o mesmo número. Números antigos (SOL-XXXX) não usam
// este contador e continuam como estão.
model SequenciaSolicitacao {
  ano    Int @id
  ultimo Int @default(0)

  @@map("sequencia_solicitacao")
}

// M11: rastreabilidade de atribuição/remoção de Analista Crítico
model AnalistaCriticoHistorico {
  id            Int      @id @default(autoincrement())
  user_id       Int // usuário que recebeu/perdeu o papel
  acao          String // ATRIBUIDO | REMOVIDO
  realizado_por Int // admin que executou a mudança
  created_at    DateTime @default(now())

  usuario  User @relation("AnalistaCriticoUser", fields: [user_id], references: [id])
  executor User @relation("AnalistaCriticoExecutor", fields: [realizado_por], references: [id])

  @@index([user_id])
  @@map("analista_critico_historico")
}

model Notificacao {
  id         Int      @id @default(autoincrement())
  user_id    Int
  titulo     String
  mensagem   String
  lida       Boolean  @default(false)
  link       String?
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([lida])
  @@map("notificacoes")
}

model PropostaTecnica {
  id                            Int       @id @default(autoincrement())
  solicitacao_id                Int
  versao                        Int
  hh_direto                     Int?
  hh_indireto                   Int?
  peso_montagem                 Decimal?  @db.Decimal(10, 2)
  // Campos exclusivos de Paradas
  efetivo_pico                  Int?
  dias_parada                   Int?
  hh_total                      Int?
  turno                         String?
  finais_de_semana              Boolean?
  // Campos exclusivos de Obras (pesos por categoria)
  peso_equipamentos             Decimal?  @db.Decimal(10, 3)
  peso_tubulacoes               Decimal?  @db.Decimal(10, 3)
  peso_suportes                 Decimal?  @db.Decimal(10, 3)
  peso_estruturas               Decimal?  @db.Decimal(10, 3)
  nao_aplicavel                 Boolean   @default(false)
  data_base                     DateTime?
  data_envio                    DateTime?
  // Previsão de execução caso a proposta seja ganha (não é prazo de envio nem data base)
  data_prevista_inicio_execucao DateTime?
  data_prevista_fim_execucao    DateTime?
  created_at                    DateTime  @default(now())
  updated_at                    DateTime  @updatedAt
  created_by                    Int

  solicitacao          Solicitacao         @relation(fields: [solicitacao_id], references: [id])
  criador              User                @relation(fields: [created_by], references: [id])
  propostas_comerciais PropostaComercial[]

  @@unique([solicitacao_id, versao])
  @@index([solicitacao_id])
  @@map("propostas_tecnicas")
}

model PropostaComercial {
  id                      Int          @id @default(autoincrement())
  solicitacao_id          Int
  proposta_tecnica_id     Int?
  versao                  Int
  nao_aplicavel           Boolean      @default(false)
  valor_montagem_mecanica Decimal?     @db.Decimal(15, 2)
  possui_terceiros        Boolean      @default(false)
  valor_eletrica          Decimal?     @db.Decimal(15, 2)
  valor_isolamento        Decimal?     @db.Decimal(15, 2)
  valor_civil             Decimal?     @db.Decimal(15, 2)
  valor_hidraulica        Decimal?     @db.Decimal(15, 2)
  valor_fibra             Decimal?     @db.Decimal(15, 2)
  valor_tijolo_antiacido  Decimal?     @db.Decimal(15, 2)
  valor_outros_terceiros  Decimal?     @db.Decimal(15, 2)
  possui_fabricacao       Boolean      @default(false)
  valor_fabricacao        Decimal?     @db.Decimal(15, 2)
  peso_fabricacao         Decimal?     @db.Decimal(10, 3)
  valor_terceiros         Decimal?     @db.Decimal(15, 2)
  valor_total             Decimal?     @db.Decimal(15, 2)
  data_base               DateTime?
  data_envio              DateTime?
  resultado               String?
  motivo_perda            MotivoPerda?
  created_at              DateTime     @default(now())
  updated_at              DateTime     @updatedAt
  created_by              Int

  solicitacao        Solicitacao        @relation(fields: [solicitacao_id], references: [id])
  proposta_tecnica   PropostaTecnica?   @relation(fields: [proposta_tecnica_id], references: [id])
  criador            User               @relation(fields: [created_by], references: [id])
  cenario_lancamento CenarioLancamento?

  @@index([solicitacao_id])
  @@map("propostas_comerciais")
}

model PropostaFabricacao {
  id                            Int          @id @default(autoincrement())
  solicitacao_id                Int
  versao                        Int
  possui_testes                 Boolean      @default(false)
  descricao_testes              String?
  valor_testes                  Decimal?     @db.Decimal(15, 2)
  possui_montagem               Boolean      @default(false)
  valor_montagem                Decimal?     @db.Decimal(15, 2)
  peso_total                    Decimal      @db.Decimal(10, 3)
  valor_total                   Decimal      @db.Decimal(15, 2)
  data_base                     DateTime?
  data_envio                    DateTime?
  // Previsão de execução caso a proposta seja ganha (não é prazo de envio nem data base)
  data_prevista_inicio_execucao DateTime?
  data_prevista_fim_execucao    DateTime?
  resultado                     String?
  motivo_perda                  MotivoPerda?
  created_at                    DateTime     @default(now())
  updated_at                    DateTime     @updatedAt
  created_by                    Int

  solicitacao  Solicitacao             @relation(fields: [solicitacao_id], references: [id])
  criador      User                    @relation(fields: [created_by], references: [id])
  equipamentos EquipamentoFabricacao[]

  @@unique([solicitacao_id, versao])
  @@index([solicitacao_id])
  @@map("propostas_fabricacao")
}

model EquipamentoFabricacao {
  id                     Int      @id @default(autoincrement())
  proposta_fabricacao_id Int
  ordem                  Int
  descricao              String
  peso_ton               Decimal  @db.Decimal(10, 3)
  valor_total            Decimal  @db.Decimal(15, 2)
  hh_previsto            Int?
  observacoes            String?
  created_at             DateTime @default(now())

  proposta_fabricacao PropostaFabricacao @relation(fields: [proposta_fabricacao_id], references: [id], onDelete: Cascade)

  @@index([proposta_fabricacao_id])
  @@map("equipamentos_fabricacao")
}

model SolicitacaoInfo {
  id               Int       @id @default(autoincrement())
  solicitacao_id   Int
  // Código sequencial por solicitação (INF-0001...). Nullable: registros
  // automáticos (encerramento de revisão) não recebem código.
  codigo           String?
  data             DateTime
  comentario       String
  // Tipo da informação (REUNIAO_CALL, DEFINICAO_INTERNA, FEEDBACK_CLIENTE,
  // DEFINICAO_ESCOPO, CONCORRENCIA, OUTROS). Nullable para registros
  // automáticos (encerramento de revisão).
  tipo             String?
  // impacto: descontinuado (mantido só por histórico, não exibido)
  impacto          String[]
  versao           Int?
  // Lixeira: exclusão vira soft-delete recuperável por 15 dias
  deleted_at       DateTime?
  deleted_by       Int?
  motivo_exclusao  String?
  created_at       DateTime  @default(now())
  created_by       Int
  substituto_de_id Int?

  solicitacao  Solicitacao            @relation(fields: [solicitacao_id], references: [id])
  criador      User                   @relation(fields: [created_by], references: [id])
  deletado_por User?                  @relation("SolicitacaoInfoDeletadoPor", fields: [deleted_by], references: [id])
  anexos       SolicitacaoInfoAnexo[]

  @@index([solicitacao_id])
  @@index([deleted_at])
  @@map("solicitacoes_info")
}

model SolicitacaoInfoAnexo {
  id         Int      @id @default(autoincrement())
  info_id    Int
  nome       String
  tipo       String // mime/extensão
  url        String // data URL (base64) ou URL externa
  tamanho    Int?
  created_at DateTime @default(now())

  info SolicitacaoInfo @relation(fields: [info_id], references: [id], onDelete: Cascade)

  @@index([info_id])
  @@map("solicitacoes_info_anexos")
}

model HhLancamento {
  id               Int      @id @default(autoincrement())
  contrato_id      Int
  versao           Int      @default(1)
  data_inicio      DateTime
  data_fim         DateTime
  motivo           String?
  created_at       DateTime @default(now())
  created_by       Int
  substituto_de_id Int?

  contrato Contrato          @relation(fields: [contrato_id], references: [id])
  criador  User              @relation("HhLancamentoCriador", fields: [created_by], references: [id])
  meses    HhLancamentoMes[]

  @@unique([contrato_id, versao])
  @@index([contrato_id])
  @@map("hh_lancamentos")
}

model HhLancamentoMes {
  id            Int  @id @default(autoincrement())
  lancamento_id Int
  mes           Int
  ano           Int
  hh_previsto   Int?
  hh_planejado  Int?

  lancamento HhLancamento @relation(fields: [lancamento_id], references: [id], onDelete: Cascade)

  @@unique([lancamento_id, mes, ano])
  @@index([lancamento_id])
  @@map("hh_lancamento_mes")
}

model HhRealizado {
  id               Int      @id @default(autoincrement())
  contrato_id      Int
  mes              Int
  ano              Int
  hh_realizado     Int
  // Soma do mês — mantidos em sincronia com HhRealizadoDia (mesma lógica de hh_realizado).
  horas_normais    Decimal? @db.Decimal(10, 2)
  horas_extras     Decimal? @db.Decimal(10, 2)
  observacoes      String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  created_by       Int
  substituto_de_id Int?

  contrato Contrato @relation(fields: [contrato_id], references: [id])
  criador  User     @relation("HhRealizadoCriador", fields: [created_by], references: [id])

  @@unique([contrato_id, mes, ano])
  @@index([contrato_id])
  @@map("hh_realizado")
}

// HH Realizado de Obras lançado DIARIAMENTE (efetivo → horas calculadas por
// regra fixa). O total mensal em HhRealizado é mantido por soma destes dias
// (ver src/app/api/acordos/hh/[id]/realizado-dia/route.ts) — HhRealizado
// continua Int de propósito, para não quebrar os consumidores existentes.
model HhRealizadoDia {
  id          Int      @id @default(autoincrement())
  contrato_id Int
  data        DateTime @db.Date

  efetivo_normal Int?
  horas_normais  Decimal? @db.Decimal(8, 2) // calculado: efetivo_normal * 8.8

  efetivo_extra     Int?
  horas_extra_valor Decimal? @db.Decimal(4, 2) // horas por pessoa extra (padrão 1, editável por dia)
  horas_extras      Decimal? @db.Decimal(8, 2) // calculado: efetivo_extra * horas_extra_valor

  hh_total Decimal @db.Decimal(8, 2) // horas_normais + horas_extras

  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  created_by       Int
  updated_by       Int?
  substituto_de_id Int?

  contrato Contrato @relation(fields: [contrato_id], references: [id])
  criador  User     @relation("HhRealizadoDiaCriador", fields: [created_by], references: [id])

  @@unique([contrato_id, data])
  @@index([contrato_id])
  @@map("hh_realizado_dia")
}

// ── Fabricações: HH por ITEM (descrição, peso, datas) ────────────────────────
model FabricacaoItem {
  id              Int       @id @default(autoincrement())
  contrato_id     Int
  descricao       String
  // OS específica deste item — opcional; alguns contratos têm uma OS por
  // equipamento em vez de uma OS única para o contrato inteiro (Contrato.num_os).
  num_os          String?
  peso_total      Decimal?  @db.Decimal(14, 2)
  data_inicio     DateTime
  data_fim        DateTime
  ordem           Int       @default(0)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  created_by      Int
  // Lixeira: exclusão vira soft-delete recuperável (mesmo padrão de NF/sub-índice)
  deleted_at      DateTime?
  deleted_by      Int?
  motivo_exclusao String?

  contrato     Contrato                  @relation(fields: [contrato_id], references: [id])
  criador      User                      @relation("FabricacaoItemCriador", fields: [created_by], references: [id])
  deletado_por User?                     @relation("FabricacaoItemDeletadoPor", fields: [deleted_by], references: [id])
  meses        FabricacaoItemMes[]
  realizados   FabricacaoRealizado[]
  historico    FabricacaoItemHistorico[]

  @@index([contrato_id])
  @@index([deleted_at])
  @@map("fabricacao_itens")
}

// HH orçado/previsto planejado por mês para cada item (habilitado pelo intervalo de datas)
model FabricacaoItemMes {
  id            Int      @id @default(autoincrement())
  item_id       Int
  mes           Int
  ano           Int
  hh_orcado     Int?
  hh_previsto   Int?
  peso_previsto Decimal? @db.Decimal(14, 2)

  item FabricacaoItem @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@unique([item_id, mes, ano])
  @@index([item_id])
  @@map("fabricacao_item_mes")
}

// Realizado lançado por mês: HH realizado + peso realizado (% de avanço = realizado/previsto, calculado)
model FabricacaoRealizado {
  id               Int      @id @default(autoincrement())
  item_id          Int
  mes              Int
  ano              Int
  hh_realizado     Int?
  peso_realizado   Decimal? @db.Decimal(14, 2)
  observacoes      String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  created_by       Int
  substituto_de_id Int?

  item    FabricacaoItem @relation(fields: [item_id], references: [id], onDelete: Cascade)
  criador User           @relation("FabricacaoRealizadoCriador", fields: [created_by], references: [id])

  @@unique([item_id, mes, ano])
  @@index([item_id])
  @@map("fabricacao_realizado")
}

// Histórico de alterações de um item de Fabricação (cadastro e lançamentos)
model FabricacaoItemHistorico {
  id         Int      @id @default(autoincrement())
  item_id    Int
  campo      String
  valor_de   String?
  valor_para String?
  created_at DateTime @default(now())
  created_by Int

  item    FabricacaoItem @relation(fields: [item_id], references: [id], onDelete: Cascade)
  usuario User           @relation("FabItemHistCriador", fields: [created_by], references: [id])

  @@index([item_id])
  @@map("fabricacao_item_historico")
}

// UCR — Faixas de classificação de R$/HH cadastradas por região (não mais por
// contrato). Aplicadas automaticamente ao contrato de Parada pelo campo
// `estado` (ver regiaoPorEstado em src/lib/ucr.ts).
enum UcrRegiao {
  ES
  MG
  BAHIA
  SP
  OUTROS
}

// Faixa de UCR vigente por REGIÃO durante um PERÍODO (início/fim) — os valores
// mudam periodicamente e cada Parada é avaliada pela vigência que estava
// cobrindo a data de início dela (ver src/lib/ucr.ts:resolverVigencia), mesmo
// que essa vigência já tenha "vencido" quando a Parada for fechada depois.
model UcrFaixaVigencia {
  id              Int       @id @default(autoincrement())
  regiao          UcrRegiao
  vigencia_inicio DateTime  @db.Date
  vigencia_fim    DateTime  @db.Date

  ucr_nao_suficiente Decimal @db.Decimal(10, 2)
  ucr_a_evoluir      Decimal @db.Decimal(10, 2)
  ucr_bom            Decimal @db.Decimal(10, 2)
  ucr_otimo          Decimal @db.Decimal(10, 2)
  ucr_esplendido     Decimal @db.Decimal(10, 2)

  created_at DateTime @default(now())
  created_by Int
  updated_at DateTime @updatedAt
  updated_by Int?

  criador     User                @relation("UcrFaixaVigenciaCriador", fields: [created_by], references: [id])
  atualizador User?               @relation("UcrFaixaVigenciaAtualizador", fields: [updated_by], references: [id])
  historico   UcrFaixaHistorico[]

  @@index([regiao, vigencia_inicio, vigencia_fim])
  @@map("ucr_faixas_vigencia")
}

// Histórico De/Para de cada alteração de vigência (valores ou datas) — mesmo
// formato de FabricacaoItemHistorico.
model UcrFaixaHistorico {
  id          Int      @id @default(autoincrement())
  vigencia_id Int
  campo       String // ucr_* (5 valores) | vigencia_inicio | vigencia_fim
  valor_de    String?
  valor_para  String
  created_at  DateTime @default(now())
  created_by  Int

  vigencia UcrFaixaVigencia @relation(fields: [vigencia_id], references: [id], onDelete: Cascade)
  usuario  User             @relation("UcrFaixaHistCriador", fields: [created_by], references: [id])

  @@index([vigencia_id])
  @@map("ucr_faixas_historico")
}

model ParadaHhConfig {
  id          Int @id @default(autoincrement())
  contrato_id Int @unique

  // Datas das etapas
  prep_inicio   DateTime?
  prep_fim      DateTime?
  parada_inicio DateTime?
  parada_fim    DateTime?
  acomp_inicio  DateTime?
  acomp_fim     DateTime?

  // Horas adicionais - pico calculado automaticamente da grade da Parada
  mob_ativo     Boolean  @default(false)
  mob_dias_prev Decimal? @db.Decimal(5, 1)
  mob_dias_real Decimal? @db.Decimal(5, 1)

  desmob_ativo     Boolean  @default(false)
  desmob_dias_prev Decimal? @db.Decimal(5, 1)
  desmob_dias_real Decimal? @db.Decimal(5, 1)

  integ_ativo     Boolean  @default(false)
  integ_dias_prev Decimal? @db.Decimal(5, 1)
  integ_dias_real Decimal? @db.Decimal(5, 1)

  folga_ativo        Boolean  @default(false)
  // Campos legados — mantidos apenas para compatibilidade com dados antigos
  // (pré-multiplas-linhas). A partir desta versão, os valores de Folga vêm
  // de ParadaFolgaLinha (uma linha por grupo de dias/efetivo), somadas.
  folga_dias_prev    Decimal? @db.Decimal(5, 1)
  folga_dias_real    Decimal? @db.Decimal(5, 1)
  folga_pessoas_prev Int?
  folga_pessoas_real Int?

  // Análise financeira — coluna "Previsto" (Orçado e Real vêm do faturamento)
  fin_prev_valor_servico Decimal? @db.Decimal(15, 2)
  fin_prev_ase           Decimal? @db.Decimal(15, 2)

  // UCR: faixas não são mais por contrato — ver UcrFaixaVigencia (cadastro
  // central por região/período, aplicado pelo Estado do contrato + data de
  // início da Parada — ver src/lib/ucr.ts).

  // Fechamento — consolida os lançamentos; reabertura exige justificativa
  // (ver ParadaFechamentoHistorico) e é restrita a perfis específicos.
  fechada_em  DateTime?
  fechada_por Int?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  contrato       Contrato                    @relation(fields: [contrato_id], references: [id])
  dias           ParadaHhDia[]
  fechamentos    ParadaFechamentoHistorico[]
  historico      ParadaHhConfigHistorico[]
  folgas         ParadaFolgaLinha[]
  quemFechou     User?                       @relation("ParadaFechadaPor", fields: [fechada_por], references: [id])
  dias_historico ParadaHhDiaHistorico[]

  @@map("parada_hh_config")
}

// Uma linha por grupo de folga (mesmo dias/efetivo) dentro da Parada — permite
// múltiplos grupos com dias e efetivo diferentes. Total de HH de Folga =
// soma de (pessoas_i * dias_i * HH_DIA) de cada linha, não uma soma agregada
// simples de dias/pessoas (ver levantamento técnico — não é linear).
model ParadaFolgaLinha {
  id           Int      @id @default(autoincrement())
  config_id    Int
  ordem        Int      @default(0)
  pessoas_prev Int?
  pessoas_real Int?
  dias_prev    Decimal? @db.Decimal(5, 1)
  dias_real    Decimal? @db.Decimal(5, 1)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  created_by   Int?

  config  ParadaHhConfig @relation(fields: [config_id], references: [id], onDelete: Cascade)
  criador User?          @relation("ParadaFolgaLinhaCriador", fields: [created_by], references: [id])

  @@index([config_id])
  @@map("parada_folga_linha")
}

// Auditoria de mudança de previsto/planejado da Parada (datas de etapa,
// adicionais de mob./desmob./integ./folga, análise financeira prevista) —
// log automático campo a campo, mesmo formato de FabricacaoItemHistorico.
model ParadaHhConfigHistorico {
  id         Int      @id @default(autoincrement())
  config_id  Int
  campo      String
  valor_de   String?
  valor_para String?
  created_at DateTime @default(now())
  created_by Int

  config  ParadaHhConfig @relation(fields: [config_id], references: [id], onDelete: Cascade)
  usuario User           @relation("ParadaHhConfigHistCriador", fields: [created_by], references: [id])

  @@index([config_id])
  @@map("parada_hh_config_historico")
}

// Auditoria de fechamento/reabertura da Parada — mesmo padrão de HhAcompanhamentoHistorico.
model ParadaFechamentoHistorico {
  id         Int      @id @default(autoincrement())
  config_id  Int
  acao       String // FECHADA | REABERTA
  motivo     String? // obrigatório só em REABERTA
  created_at DateTime @default(now())
  created_by Int

  config  ParadaHhConfig @relation(fields: [config_id], references: [id], onDelete: Cascade)
  usuario User           @relation("ParadaFechHistCriador", fields: [created_by], references: [id])

  @@index([config_id])
  @@map("parada_fechamento_historico")
}

model ParadaHhDia {
  id        Int      @id @default(autoincrement())
  config_id Int
  etapa     String // PREPARATIVO | PARADA | ACOMP_DESMOB
  data      DateTime @db.Date

  efetivo_plan   Int?
  horas_dia_plan Decimal? @default(9.8) @db.Decimal(5, 2)
  hh_plan        Decimal? @db.Decimal(10, 2)
  efetivo_real   Int?
  horas_dia_real Decimal? @default(9.8) @db.Decimal(5, 2)
  hh_real        Decimal? @db.Decimal(10, 2)

  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  // Quem lançou/alterou este dia — nullable porque dias já existentes antes desta
  // coluna não têm essa informação (mesmo padrão de solicitado_por/revisado_por
  // em NotaFiscalContrato: resolvido à parte via lookup de usuário, sem relation).
  created_by       Int?
  updated_by       Int?
  substituto_de_id Int?

  config ParadaHhConfig @relation(fields: [config_id], references: [id])

  @@unique([config_id, etapa, data])
  @@index([config_id])
  @@index([config_id, etapa])
  @@map("parada_hh_dia")
}

model Acordo {
  id                   Int          @id @default(autoincrement())
  numero               String       @unique
  cliente_id           Int
  descricao            String?
  valor_total          Decimal      @db.Decimal(15, 2)
  ano                  Int
  valor_anos_seguintes Decimal?     @db.Decimal(15, 2)
  status               StatusAcordo @default(ATIVO)
  data_inicio          DateTime?
  data_fim             DateTime?
  created_at           DateTime     @default(now())
  updated_at           DateTime     @updatedAt
  created_by           Int
  cancelled_at         DateTime?
  cancel_reason        String?

  cliente       Cliente      @relation(fields: [cliente_id], references: [id])
  criador       User         @relation(fields: [created_by], references: [id])
  notas_fiscais NotaFiscal[]

  @@index([cliente_id])
  @@index([ano])
  @@index([status])
  @@index([cancelled_at])
  @@map("acordos")
}

model NotaFiscal {
  id                Int      @id @default(autoincrement())
  acordo_id         Int
  numero_nf         String
  valor             Decimal  @db.Decimal(15, 2)
  data_emissao      DateTime
  data_vencimento   DateTime
  ativa             Boolean  @default(true)
  motivo_inativacao String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  created_by        Int

  acordo  Acordo @relation(fields: [acordo_id], references: [id])
  criador User   @relation(fields: [created_by], references: [id])

  @@index([acordo_id])
  @@map("notas_fiscais")
}

// ─── Módulo Controle de Faturamento ──────────────────────────────────────────

model Contrato {
  id               Int               @id @default(autoincrement())
  indice           String            @unique
  ano_referencia   Int
  status           StatusFaturamento @default(A_FATURAR)
  cliente_id       Int
  num_os           String?
  num_acordo       String?
  num_proposta     String?
  solicitacao_id   Int?
  responsavel_id   Int?
  cliente_final_id Int?
  cidade           String?
  estado           String?           @db.VarChar(2)
  data_inicio      DateTime?
  data_fim         DateTime?
  descricao        String?
  classificacao    Classificacao?
  valor_contrato   Decimal?          @db.Decimal(15, 2)
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  created_by       Int
  cancelled_at     DateTime?
  cancel_reason    String?
  cancelled_by     Int?
  rascunho         Boolean           @default(false)
  // Lixeira: exclusão do Controle de Faturamento vira soft-delete restaurável por 15 dias
  deleted_at       DateTime?
  deleted_by       Int?
  // Soft-cancel do acompanhamento de HH (Obras/Paradas) — RN-18 (não exclui, cancela com motivo)
  hh_cancelado_at  DateTime?
  hh_cancel_motivo String?
  hh_cancelado_por Int?

  // Fechamento do acompanhamento de HH — Obras e Fabricações (Paradas usa seu
  // próprio ParadaHhConfig.fechada_em, pois já tem um modelo de config
  // dedicado por contrato). Consolida os lançamentos; reabertura exige
  // justificativa — mesmo padrão/UX do botão "Fechar Parada".
  hh_fechada_em  DateTime?
  hh_fechada_por Int?

  cliente                    Cliente                         @relation("ContratoCliente", fields: [cliente_id], references: [id])
  cliente_final              Cliente?                        @relation("ContratoClienteFinal", fields: [cliente_final_id], references: [id])
  responsavel                User?                           @relation("ContratoResponsavel", fields: [responsavel_id], references: [id])
  criador                    User                            @relation("ContratoCriador", fields: [created_by], references: [id])
  solicitacao                Solicitacao?                    @relation(fields: [solicitacao_id], references: [id])
  subindices                 SubIndiceFaturamento[]
  historico                  HistoricoContrato[]
  hh_lancamentos             HhLancamento[]
  hh_realizados              HhRealizado[]
  hh_realizados_dia          HhRealizadoDia[]
  hh_acomp_historico         HhAcompanhamentoHistorico[]
  fabricacao_itens           FabricacaoItem[]
  parada_hh_config           ParadaHhConfig?
  ocorrencias                OcorrenciaContratual[]
  multas                     MultaPenalidade[]
  quemFechouHh               User?                           @relation("ContratoHhFechadaPor", fields: [hh_fechada_por], references: [id])
  hh_fechamentos             ContratoHhFechamentoHistorico[]
  cancelador                 User?                           @relation("ContratoCanceladoPor", fields: [cancelled_by], references: [id])
  deletado_por               User?                           @relation("ContratoDeletadoPor", fields: [deleted_by], references: [id])
  hh_cancelador              User?                           @relation("ContratoHhCanceladoPor", fields: [hh_cancelado_por], references: [id])
  hh_realizado_dia_historico HhRealizadoDiaHistorico[]

  @@index([cliente_id])
  @@index([cliente_final_id])
  @@index([solicitacao_id])
  @@index([ano_referencia])
  @@index([status])
  @@index([cancelled_at])
  @@index([hh_cancelado_at])
  @@index([responsavel_id])
  @@map("contratos")
}

// Histórico de remoção/reativação do acompanhamento de HH (RN-18: rastreabilidade)
model HhAcompanhamentoHistorico {
  id          Int      @id @default(autoincrement())
  contrato_id Int
  acao        String // CANCELADO | REATIVADO
  motivo      String?
  created_at  DateTime @default(now())
  created_by  Int

  contrato Contrato @relation(fields: [contrato_id], references: [id], onDelete: Cascade)
  usuario  User     @relation("HhAcompHistCriador", fields: [created_by], references: [id])

  @@index([contrato_id])
  @@map("hh_acompanhamento_historico")
}

// Auditoria de fechamento/reabertura do acompanhamento de HH — Obras e
// Fabricações (mesmo padrão de ParadaFechamentoHistorico).
model ContratoHhFechamentoHistorico {
  id          Int      @id @default(autoincrement())
  contrato_id Int
  acao        String // FECHADA | REABERTA
  motivo      String? // obrigatório só em REABERTA
  created_at  DateTime @default(now())
  created_by  Int

  contrato Contrato @relation(fields: [contrato_id], references: [id], onDelete: Cascade)
  usuario  User     @relation("ContratoHhFechHistCriador", fields: [created_by], references: [id])

  @@index([contrato_id])
  @@map("contrato_hh_fechamento_historico")
}

model HistoricoContrato {
  id               Int      @id @default(autoincrement())
  contrato_id      Int
  campo            String
  valor_de         String?
  valor_para       String?
  created_at       DateTime @default(now())
  created_by       Int
  substituto_de_id Int?

  contrato Contrato @relation(fields: [contrato_id], references: [id], onDelete: Cascade)
  usuario  User     @relation("HistContratoCriador", fields: [created_by], references: [id])

  @@index([contrato_id])
  @@map("historico_contratos")
}

// ─── Ocorrências Contratuais (gestão de acontecimentos durante o contrato) ────
model OcorrenciaContratual {
  id                       Int       @id @default(autoincrement())
  contrato_id              Int
  codigo                   String // ex.: OC-0001 (sequencial por contrato)
  tipo                     String // ver TIPOS em src/lib/ocorrencias.ts
  data                     DateTime // data do evento
  responsabilidade         String // CLIENTE | FORCA_MAIOR | IMETAME | TERCEIROS
  impacto                  String[] // PRAZO | CUSTO | CRONOGRAMA | MARCO_CONTRATUAL | OUTROS
  descricao                String
  data_notificacao_cliente DateTime?
  // Lixeira: exclusão vira soft-delete recuperável por 15 dias
  deleted_at               DateTime?
  deleted_by               Int?
  motivo_exclusao          String?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt
  created_by               Int
  substituto_de_id         Int?

  contrato     Contrato          @relation(fields: [contrato_id], references: [id], onDelete: Cascade)
  criador      User              @relation("OcorrenciaCriador", fields: [created_by], references: [id])
  deletado_por User?             @relation("OcorrenciaDeletadoPor", fields: [deleted_by], references: [id])
  anexos       OcorrenciaAnexo[]

  @@unique([contrato_id, codigo])
  @@index([contrato_id])
  @@index([data])
  @@index([deleted_at])
  @@map("ocorrencias_contratuais")
}

// ─── Multas / Penalidades (movimentações financeiras do contrato) ─────────────
model MultaPenalidade {
  id                       Int       @id @default(autoincrement())
  contrato_id              Int
  tipo                     String // MULTA | GLOSAS | REEMBOLSOS | OUTROS
  descricao                String
  data_ocorrencia          DateTime
  data_notificacao_cliente DateTime?
  data_desconto            DateTime?
  valor_total              Decimal   @db.Decimal(15, 2)
  ativa                    Boolean   @default(true)
  motivo_inativacao        String?
  // Lixeira: exclusão vira soft-delete recuperável por 15 dias
  deleted_at               DateTime?
  deleted_by               Int?
  motivo_exclusao          String?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt
  created_by               Int
  substituto_de_id         Int?

  contrato     Contrato                   @relation(fields: [contrato_id], references: [id], onDelete: Cascade)
  criador      User                       @relation("MultaCriador", fields: [created_by], references: [id])
  deletado_por User?                      @relation("MultaDeletadoPor", fields: [deleted_by], references: [id])
  historico    MultaPenalidadeHistorico[]

  @@index([contrato_id])
  @@index([data_ocorrencia])
  @@index([deleted_at])
  @@map("multas_penalidades")
}

// Auditoria de alterações de Multa/Penalidade — mesmo formato de HistoricoContrato.
model MultaPenalidadeHistorico {
  id         Int      @id @default(autoincrement())
  multa_id   Int
  campo      String
  valor_de   String?
  valor_para String?
  created_at DateTime @default(now())
  created_by Int

  multa   MultaPenalidade @relation(fields: [multa_id], references: [id], onDelete: Cascade)
  usuario User            @relation("MultaHistCriador", fields: [created_by], references: [id])

  @@index([multa_id])
  @@map("multas_penalidades_historico")
}

model OcorrenciaAnexo {
  id            Int      @id @default(autoincrement())
  ocorrencia_id Int
  nome          String
  tipo          String // mime/extensão (ex.: application/pdf, image/png)
  url           String
  tamanho       Int? // bytes
  created_at    DateTime @default(now())

  ocorrencia OcorrenciaContratual @relation(fields: [ocorrencia_id], references: [id], onDelete: Cascade)

  @@index([ocorrencia_id])
  @@map("ocorrencias_anexos")
}

model SubIndiceFaturamento {
  id                    Int       @id @default(autoincrement())
  contrato_id           Int
  ordem                 Int
  descricao             String
  valor_total           Decimal   @db.Decimal(15, 2)
  data_inicio           DateTime?
  data_fim              DateTime?
  num_os                String?
  comentarios           String?
  comentario_updated_at DateTime?
  comentario_updated_by Int?
  jan                   Decimal?  @db.Decimal(15, 2)
  fev                   Decimal?  @db.Decimal(15, 2)
  mar                   Decimal?  @db.Decimal(15, 2)
  abr                   Decimal?  @db.Decimal(15, 2)
  mai                   Decimal?  @db.Decimal(15, 2)
  jun                   Decimal?  @db.Decimal(15, 2)
  jul                   Decimal?  @db.Decimal(15, 2)
  ago                   Decimal?  @db.Decimal(15, 2)
  set                   Decimal?  @map("set_col") @db.Decimal(15, 2)
  out                   Decimal?  @db.Decimal(15, 2)
  nov                   Decimal?  @db.Decimal(15, 2)
  dez                   Decimal?  @db.Decimal(15, 2)
  // Lixeira: exclusão vira soft-delete recuperável por 15 dias
  deleted_at            DateTime?
  deleted_by            Int?
  motivo_exclusao       String?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  created_by            Int

  contrato         Contrato             @relation(fields: [contrato_id], references: [id], onDelete: Cascade)
  criador          User                 @relation("SubIndiceCriador", fields: [created_by], references: [id])
  comentario_autor User?                @relation("SubIndiceComentarioAutor", fields: [comentario_updated_by], references: [id])
  deletado_por     User?                @relation("SubIndiceDeletadoPor", fields: [deleted_by], references: [id])
  notas_fiscais    NotaFiscalContrato[]
  consolidados     ConsolidadoMesItem[]
  historico        HistoricoSubIndice[]
  alteracoes       PrevisaoAlteracao[]

  @@index([contrato_id])
  @@index([deleted_at])
  @@map("subindices_faturamento")
}

model HistoricoSubIndice {
  id               Int      @id @default(autoincrement())
  subindice_id     Int
  campo            String
  valor_de         String?
  valor_para       String?
  created_at       DateTime @default(now())
  created_by       Int
  substituto_de_id Int?

  subindice SubIndiceFaturamento @relation(fields: [subindice_id], references: [id], onDelete: Cascade)
  usuario   User                 @relation("HistSubIndiceCriador", fields: [created_by], references: [id])

  @@index([subindice_id])
  @@map("historico_subindices")
}

model NotaFiscalContrato {
  id                Int       @id @default(autoincrement())
  subindice_id      Int
  numero_nf         String
  valor_total_nf    Decimal   @db.Decimal(15, 2)
  percentual        Decimal   @default(100) @db.Decimal(5, 2)
  valor_atribuido   Decimal   @db.Decimal(15, 2)
  data_emissao      DateTime
  data_vencimento   DateTime
  ativa             Boolean   @default(true)
  motivo_inativacao String?
  // Classificação do lançamento — distinta do tipo de documento (NF/Recibo/Outros).
  // Usada no indicador "Composição Faturamento".
  tipo_lancamento   String?   @default("Normal")
  tipo_documento    String?   @default("NF")
  // Fluxo de aprovação de lançamento de faturamento (responsável -> coordenação)
  status_aprovacao  String    @default("APROVADO") // APROVADO | PENDENTE | REPROVADO
  solicitado_por    Int?
  revisado_por      Int?
  revisado_em       DateTime?
  motivo_recusa     String?
  // Lixeira: exclusão vira soft-delete recuperável por 15 dias
  deleted_at        DateTime?
  deleted_by        Int?
  motivo_exclusao   String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  created_by        Int
  substituto_de_id  Int?

  subindice    SubIndiceFaturamento  @relation(fields: [subindice_id], references: [id], onDelete: Cascade)
  criador      User                  @relation("NFContratoCriador", fields: [created_by], references: [id])
  deletado_por User?                 @relation("NFContratoDeletadoPor", fields: [deleted_by], references: [id])
  solicitante  User?                 @relation("NFContratoSolicitadoPor", fields: [solicitado_por], references: [id])
  revisor      User?                 @relation("NFContratoRevisadoPor", fields: [revisado_por], references: [id])
  alteracoes   NotaFiscalAlteracao[]

  @@index([subindice_id])
  @@index([numero_nf, ativa])
  @@index([status_aprovacao])
  @@index([deleted_at])
  @@map("notas_fiscais_contratos")
}

enum StatusAlteracaoNF {
  PENDENTE
  APROVADO
  REPROVADO
}

// Edição pendente de uma NF já ativa/aprovada — RN: a edição fica em análise
// da coordenação, mas os dados ATUAIS da NF continuam contando no faturamento
// normalmente até a nova aprovação (mesmo padrão de PrevisaoAlteracao).
model NotaFiscalAlteracao {
  id             Int               @id @default(autoincrement())
  nf_id          Int
  responsavel_id Int
  status         StatusAlteracaoNF @default(PENDENTE)
  motivo_recusa  String?
  revisor_id     Int?
  reviewed_at    DateTime?

  numero_nf_de         String
  numero_nf_para       String
  valor_total_nf_de    Decimal  @db.Decimal(15, 2)
  valor_total_nf_para  Decimal  @db.Decimal(15, 2)
  percentual_de        Decimal  @db.Decimal(5, 2)
  percentual_para      Decimal  @db.Decimal(5, 2)
  data_emissao_de      DateTime
  data_emissao_para    DateTime
  data_vencimento_de   DateTime
  data_vencimento_para DateTime
  subindice_id_de      Int
  subindice_id_para    Int

  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  created_by       Int
  substituto_de_id Int?

  nf NotaFiscalContrato @relation(fields: [nf_id], references: [id], onDelete: Cascade)

  @@index([nf_id])
  @@index([responsavel_id])
  @@index([status])
  @@map("nota_fiscal_alteracoes")
}

// ─── Consolidado Mensal (Previsão x Realizado) ────────────────────────────────

model ConsolidadoMes {
  id           Int       @id @default(autoincrement())
  mes          Int // 1-12
  ano          Int
  arquivado_at DateTime? // RN-CF-12: null = ativo; preenchido = arquivado
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  created_by   Int

  criador User                 @relation("ConsolidadoCriador", fields: [created_by], references: [id])
  itens   ConsolidadoMesItem[]

  @@index([mes, ano])
  @@index([ano])
  @@map("consolidados_mes")
}

model ConsolidadoMesItem {
  id             Int     @id @default(autoincrement())
  consolidado_id Int
  subindice_id   Int
  valor_previsto Decimal @db.Decimal(15, 2)

  consolidado ConsolidadoMes       @relation(fields: [consolidado_id], references: [id], onDelete: Cascade)
  subindice   SubIndiceFaturamento @relation(fields: [subindice_id], references: [id], onDelete: Cascade)

  @@index([consolidado_id])
  @@index([subindice_id])
  @@map("consolidados_mes_itens")
}

// ─── Workflow de aprovação de previsão ────────────────────────────────────────

enum StatusAlteracaoPrevisao {
  PENDENTE
  APROVADO
  REPROVADO
}

model PrevisaoAlteracao {
  id             Int                     @id @default(autoincrement())
  subindice_id   Int
  responsavel_id Int
  status         StatusAlteracaoPrevisao @default(PENDENTE)
  motivo_recusa  String?
  revisor_id     Int?
  reviewed_at    DateTime?

  jan_de Decimal? @db.Decimal(15, 2)
  fev_de Decimal? @db.Decimal(15, 2)
  mar_de Decimal? @db.Decimal(15, 2)
  abr_de Decimal? @db.Decimal(15, 2)
  mai_de Decimal? @db.Decimal(15, 2)
  jun_de Decimal? @db.Decimal(15, 2)
  jul_de Decimal? @db.Decimal(15, 2)
  ago_de Decimal? @db.Decimal(15, 2)
  set_de Decimal? @db.Decimal(15, 2)
  out_de Decimal? @db.Decimal(15, 2)
  nov_de Decimal? @db.Decimal(15, 2)
  dez_de Decimal? @db.Decimal(15, 2)

  jan_para Decimal? @db.Decimal(15, 2)
  fev_para Decimal? @db.Decimal(15, 2)
  mar_para Decimal? @db.Decimal(15, 2)
  abr_para Decimal? @db.Decimal(15, 2)
  mai_para Decimal? @db.Decimal(15, 2)
  jun_para Decimal? @db.Decimal(15, 2)
  jul_para Decimal? @db.Decimal(15, 2)
  ago_para Decimal? @db.Decimal(15, 2)
  set_para Decimal? @db.Decimal(15, 2)
  out_para Decimal? @db.Decimal(15, 2)
  nov_para Decimal? @db.Decimal(15, 2)
  dez_para Decimal? @db.Decimal(15, 2)

  // Alteração do Valor Total do subíndice — mesma tabela/fluxo de aprovação da
  // previsão mensal (nullable: uma PrevisaoAlteracao pode mexer só na previsão,
  // só no valor total, ou nos dois ao mesmo tempo).
  valor_total_de   Decimal? @db.Decimal(15, 2)
  valor_total_para Decimal? @db.Decimal(15, 2)
  // Motivo/justificativa informado pelo responsável ao propor a alteração de
  // Valor Total (obrigatório nesse caso) — distinto de motivo_recusa, que é da
  // Gestão ao reprovar. Hoje só usado quando valor_total_para != null.
  motivo           String?

  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  created_by       Int
  substituto_de_id Int?

  subindice   SubIndiceFaturamento @relation(fields: [subindice_id], references: [id], onDelete: Cascade)
  responsavel User                 @relation("AlteracaoResponsavel", fields: [responsavel_id], references: [id])
  revisor     User?                @relation("AlteracaoRevisor", fields: [revisor_id], references: [id])
  criador     User                 @relation("AlteracaoCriador", fields: [created_by], references: [id])

  @@index([subindice_id])
  @@index([responsavel_id])
  @@index([status])
  @@map("previsao_alteracoes")
}

// ─── Relatório de abertura de OS (preenchido quando a proposta é GANHA) ───────
// Limpo automaticamente se o resultado da proposta for alterado depois.
model RelatorioOS {
  id                     Int      @id @default(autoincrement())
  solicitacao_id         Int      @unique
  classificacao          String
  cliente_faturamento_id Int
  cliente_final          String?
  numero_solicitacao     String
  data_inicio            DateTime
  data_fim               DateTime
  responsavel_imetame    String
  local_realizacao       String
  gestor_cliente         String
  valor_estimado         Decimal  @db.Decimal(15, 2)
  escopo                 String
  unidade_medida         String // KG | TON | PC | CJ
  quantidade             Decimal  @db.Decimal(12, 2)
  ncm                    String?
  pintura                Boolean
  retorno                Boolean
  memorial_calculo       Boolean
  material               String? // IMETAME | TERCEIROS | AMBOS
  art                    Boolean
  databook               Boolean
  material_apoio         Boolean
  comentario             String?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt
  created_by             Int

  solicitacao         Solicitacao @relation(fields: [solicitacao_id], references: [id], onDelete: Cascade)
  cliente_faturamento Cliente     @relation("RelatorioOSClienteFat", fields: [cliente_faturamento_id], references: [id])
  criador             User        @relation("RelatorioOSCriador", fields: [created_by], references: [id])

  @@map("relatorios_os")
}

// ─── Revisões pendentes de avaliação do orçamentista ──────────────────────────
// Uma nova revisão só é aplicada à solicitação depois que o orçamentista
// confirmar que é de fato uma revisão; caso contrário é devolvida com
// justificativa. O payload guarda os dados informados na abertura.
model RevisaoPendente {
  id             Int       @id @default(autoincrement())
  solicitacao_id Int
  payload        Json
  status         String    @default("PENDENTE") // PENDENTE | APROVADA | RECUSADA
  justificativa  String? // preenchida pelo orçamentista na devolução
  avaliado_por   Int?
  avaliado_em    DateTime?
  created_at     DateTime  @default(now())
  created_by     Int

  solicitacao Solicitacao @relation(fields: [solicitacao_id], references: [id], onDelete: Cascade)
  criador     User        @relation("RevisaoPendenteCriador", fields: [created_by], references: [id])
  avaliador   User?       @relation("RevisaoPendenteAvaliador", fields: [avaliado_por], references: [id])

  @@index([solicitacao_id])
  @@index([status])
  @@map("revisoes_pendentes")
}

// ─── Construtor de Relatório: relatórios salvos + versionamento ────────────────

model RelatorioSalvo {
  id         Int       @id @default(autoincrement())
  nome       String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  created_by Int
  deleted_at DateTime? // soft delete (RN-18)
  deleted_by Int?

  criador      User              @relation("RelatorioCriador", fields: [created_by], references: [id])
  deletado_por User?             @relation("RelatorioDeletadoPor", fields: [deleted_by], references: [id])
  versoes      RelatorioVersao[]

  @@index([created_by])
  @@index([deleted_at])
  @@map("relatorios_salvos")
}

model RelatorioVersao {
  id           Int      @id @default(autoincrement())
  relatorio_id Int
  versao       Int
  config       Json // { modulo, linhas, colunas, valores, filtros }
  created_at   DateTime @default(now())
  created_by   Int

  relatorio RelatorioSalvo @relation(fields: [relatorio_id], references: [id], onDelete: Cascade)
  autor     User           @relation("RelatorioVersaoAutor", fields: [created_by], references: [id])

  @@unique([relatorio_id, versao])
  @@index([relatorio_id])
  @@map("relatorios_versoes")
}

// ─── Cenário (módulo Comercial): projeção de carga de efetivo futura ──────────
// v1: apenas Obras e Paradas (efetivo). Fabricações/Óleo e Gás (toneladas) ficam
// para uma 2ª etapa.

// Parâmetro único (singleton, id=1) — capacidade de efetivo da empresa usada
// como referência de comparação no Cenário.
model CenarioConfig {
  id                 Int      @id @default(autoincrement())
  capacidade_efetivo Int
  updated_at         DateTime @updatedAt
  updated_by         Int

  atualizador User @relation("CenarioConfigAtualizador", fields: [updated_by], references: [id])

  @@map("cenario_config")
}

// Um lançamento por proposta comercial (1:1) — a origem (CONTRATO/PROPOSTA) é
// sempre computada a partir do `resultado` da proposta vinculada, nunca
// armazenada aqui (ver src/lib/cenario.ts). Dados denormalizados de propósito:
// podem ser ajustados no lançamento, divergindo da proposta de origem.
model CenarioLancamento {
  id                    Int           @id @default(autoincrement())
  proposta_comercial_id Int           @unique
  cliente_nome          String
  cliente_final_nome    String?
  cidade                String?
  estado                String?       @db.VarChar(2)
  escopo                String?
  orcamentista_nome     String?
  classificacao         Classificacao
  data_inicio           DateTime
  data_fim              DateTime
  efetivo               Int
  // Efetivo por mês (Obras/Fabricações/Óleo e Gás) — { "AAAA-MM": efetivo }.
  // Null para Paradas (sempre usa o valor único `efetivo`) e para lançamentos
  // antigos sem detalhamento mensal — nesse caso todo mês do período usa `efetivo`.
  efetivo_mensal        Json?
  observacao            String?
  created_at            DateTime      @default(now())
  updated_at            DateTime      @updatedAt
  created_by            Int
  updated_by            Int?
  // RN-18: exclusão não permitida — soft-cancel com justificativa
  cancelled_at          DateTime?
  cancel_reason         String?
  cancelled_by          Int?

  proposta_comercial PropostaComercial            @relation(fields: [proposta_comercial_id], references: [id])
  criador            User                         @relation("CenarioLancCriador", fields: [created_by], references: [id])
  atualizador        User?                        @relation("CenarioLancAtualizador", fields: [updated_by], references: [id])
  cancelador         User?                        @relation("CenarioLancCanceladoPor", fields: [cancelled_by], references: [id])
  historico          CenarioLancamentoHistorico[]

  @@index([cancelled_at])
  @@map("cenario_lancamentos")
}

model CenarioLancamentoHistorico {
  id            Int      @id @default(autoincrement())
  lancamento_id Int
  campo         String
  valor_de      String?
  valor_para    String?
  created_at    DateTime @default(now())
  created_by    Int

  lancamento CenarioLancamento @relation(fields: [lancamento_id], references: [id], onDelete: Cascade)
  usuario    User              @relation("CenarioLancHistCriador", fields: [created_by], references: [id])

  @@index([lancamento_id])
  @@map("cenario_lancamentos_historico")
}

// Retrato: cópia congelada e completa do Cenário num momento — usada nas
// reuniões periódicas. Imutável após criado (só consulta ou exclusão).
model CenarioRetrato {
  id                 Int      @id @default(autoincrement())
  nome               String
  observacao         String?
  capacidade_efetivo Int
  created_at         DateTime @default(now())
  created_by         Int

  criador     User                       @relation("CenarioRetratoCriador", fields: [created_by], references: [id])
  lancamentos CenarioRetratoLancamento[]

  @@index([created_at])
  @@map("cenario_retratos")
}

// Linha congelada de um retrato — cópia denormalizada completa (não é FK viva;
// proposta_comercial_id é mantido só como chave de correspondência para a
// comparação com o cenário atual).
model CenarioRetratoLancamento {
  id                    Int           @id @default(autoincrement())
  retrato_id            Int
  proposta_comercial_id Int
  cliente_nome          String
  cliente_final_nome    String?
  cidade                String?
  estado                String?       @db.VarChar(2)
  escopo                String?
  orcamentista_nome     String?
  classificacao         Classificacao
  origem                String // 'CONTRATO' | 'PROPOSTA' — congelado no momento do retrato
  data_inicio           DateTime
  data_fim              DateTime
  efetivo               Int
  observacao            String?

  retrato CenarioRetrato @relation(fields: [retrato_id], references: [id], onDelete: Cascade)

  @@index([retrato_id])
  @@index([proposta_comercial_id])
  @@map("cenario_retratos_lancamentos")
}

// ─── Substituições e transferências de responsabilidade ───────────────────────
// Cadastro único válido para os dois módulos (Comercial e Acordos) — a operação
// é sobre a PESSOA, não sobre o módulo. Titularidade só existe em dois lugares
// no schema (Solicitacao.orcamentista_id e Contrato.responsavel_id); os demais
// registros (propostas, NFs, HH, ocorrências) seguem automaticamente por
// referenciarem esses dois.

// Tipo 1 — Substituição temporária: titularidade NÃO muda; o substituto ganha,
// durante o período, exatamente as mesmas permissões do titular. "Vigente" é
// sempre calculado por data (nunca gravado) — começa e acaba sozinha.
model SubstituicaoTemporaria {
  id               Int       @id @default(autoincrement())
  titular_id       Int
  substituto_id    Int
  data_inicio      DateTime
  data_fim         DateTime
  motivo_tipo      String // FERIAS | AFASTAMENTO | LICENCA | OUTRO
  motivo_detalhe   String?
  // Encerramento antecipado — se preenchido, a substituição deixa de valer a
  // partir desta data mesmo que data_fim ainda não tenha chegado.
  encerrada_em     DateTime?
  encerrada_por    Int?
  encerrada_motivo String?
  created_at       DateTime  @default(now())
  created_by       Int
  updated_at       DateTime  @updatedAt

  titular      User                      @relation("SubstTitular", fields: [titular_id], references: [id])
  substituto   User                      @relation("SubstSubstituto", fields: [substituto_id], references: [id])
  criador      User                      @relation("SubstCriador", fields: [created_by], references: [id])
  prorrogacoes SubstituicaoProrrogacao[]

  @@index([titular_id])
  @@index([substituto_id])
  @@map("substituicoes_temporarias")
}

model SubstituicaoProrrogacao {
  id                Int      @id @default(autoincrement())
  substituicao_id   Int
  data_fim_anterior DateTime
  data_fim_nova     DateTime
  motivo            String
  created_at        DateTime @default(now())
  created_by        Int

  substituicao SubstituicaoTemporaria @relation(fields: [substituicao_id], references: [id], onDelete: Cascade)
  criador      User                   @relation("SubstProrrogacaoCriador", fields: [created_by], references: [id])

  @@index([substituicao_id])
  @@map("substituicoes_prorrogacoes")
}

// Tipos 2 e 3 — Transferência definitiva (A→B) e Troca definitiva (A↔B):
// titularidade MUDA nos itens selecionados. Sem data de fim — permanente.
// "origem"/"destino" cobrem tanto a Transferência (origem=atual, destino=novo)
// quanto a Troca (origem=A, destino=B; os itens de B→A ficam marcados por
// TransferenciaItem.direcao).
model TransferenciaResponsabilidade {
  id              Int       @id @default(autoincrement())
  tipo            String // TRANSFERENCIA | TROCA
  origem_id       Int
  destino_id      Int
  data_efetivacao DateTime
  motivo          String
  // Carimbado quando a troca de titularidade de fato roda (na hora, se
  // data_efetivacao <= hoje; ou depois, pelo cron de efetivação).
  efetivada_em    DateTime?
  created_at      DateTime  @default(now())
  created_by      Int

  origem  User                @relation("TransfOrigem", fields: [origem_id], references: [id])
  destino User                @relation("TransfDestino", fields: [destino_id], references: [id])
  criador User                @relation("TransfCriador", fields: [created_by], references: [id])
  itens   TransferenciaItem[]

  @@map("transferencias_responsabilidade")
}

model TransferenciaItem {
  id                      Int     @id @default(autoincrement())
  transferencia_id        Int
  tipo_item               String // SOLICITACAO | CONTRATO
  item_id                 Int
  direcao                 String? // TROCA: 'A_PARA_B' | 'B_PARA_A' (null na TRANSFERENCIA)
  responsavel_anterior_id Int
  responsavel_novo_id     Int

  transferencia TransferenciaResponsabilidade @relation(fields: [transferencia_id], references: [id], onDelete: Cascade)

  @@index([transferencia_id])
  @@map("transferencias_itens")
}

// ─── Auditoria e rastreabilidade (Etapa 2 — diagnóstico de rastreabilidade) ───

// Alterações de cadastro do usuário (perfil, ativo, e-mail, nome, redefinição
// de senha) — mesmo formato de ClienteHistorico/FabricacaoItemHistorico.
// Não registra a senha em si, só o evento "senha redefinida".
model UsuarioHistorico {
  id         Int      @id @default(autoincrement())
  user_id    Int
  campo      String
  valor_de   String?
  valor_para String?
  created_at DateTime @default(now())
  created_by Int

  usuario User @relation("UsuarioHistUsuario", fields: [user_id], references: [id], onDelete: Cascade)
  autor   User @relation("UsuarioHistCriador", fields: [created_by], references: [id])

  @@index([user_id])
  @@map("usuarios_historico")
}

// Registro de acesso (login) — sucesso e falha. user_id fica nulo quando o
// e-mail informado não corresponde a nenhum usuário (tentativa com e-mail
// inválido/inexistente); o e-mail digitado é sempre preservado.
model LoginHistorico {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  email      String
  sucesso    Boolean
  motivo     String? // preenchido em falha: SENHA_INVALIDA | USUARIO_INATIVO | BLOQUEADO | EMAIL_NAO_ENCONTRADO
  ip         String?
  user_agent String?
  created_at DateTime @default(now())

  usuario User? @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([email])
  @@index([created_at])
  @@map("login_historico")
}

// Diff completo de cada lançamento/edição de HH Realizado diário de Obras —
// HhRealizadoDia guarda só o último estado (upsert); este modelo preserva
// cada alteração individual, mesmo formato de FabricacaoItemHistorico.
// Referencia contrato_id + data (não o id da linha em HhRealizadoDia, que
// pode ser removida via deleteMany quando o dia fica vazio).
model HhRealizadoDiaHistorico {
  id          Int      @id @default(autoincrement())
  contrato_id Int
  data        DateTime @db.Date
  campo       String
  valor_de    String?
  valor_para  String?
  created_at  DateTime @default(now())
  created_by  Int

  contrato Contrato @relation(fields: [contrato_id], references: [id], onDelete: Cascade)
  usuario  User     @relation("HhRealizadoDiaHistCriador", fields: [created_by], references: [id])

  @@index([contrato_id])
  @@index([contrato_id, data])
  @@map("hh_realizado_dia_historico")
}

// Mesma ideia acima, para o lançamento diário de Paradas (ParadaHhDia).
model ParadaHhDiaHistorico {
  id         Int      @id @default(autoincrement())
  config_id  Int
  etapa      String
  data       DateTime @db.Date
  campo      String
  valor_de   String?
  valor_para String?
  created_at DateTime @default(now())
  created_by Int

  config  ParadaHhConfig @relation(fields: [config_id], references: [id], onDelete: Cascade)
  usuario User           @relation("ParadaHhDiaHistCriador", fields: [created_by], references: [id])

  @@index([config_id])
  @@index([config_id, etapa, data])
  @@map("parada_hh_dia_historico")
}
